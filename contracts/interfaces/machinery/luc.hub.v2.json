    {
      "id": "code-review-bound",
      "text": "Non-instruction public versions require an approval bound to that exact artifact hash; an Extension also requires a listed parent.",
      "test": null
    },
    {
      "id": "no-runtime-grants",
      "text": "A listing decision changes public visibility only, not a Runtime permission receipt.",
      "test": null
