{
  "format": "lumeri.interface/v1",
  "id": "iface:luc.hub/v2",
  "version": "2.0.0",
  "area": "machinery",
  "title": "Luc Hub listing and account views",
  "summary": "Layer handles, private/public visibility, exact-version review and public search on immutable Cloud packages. Hub listing never grants local Host permissions.",
