    ]
  },
  "conformance": {
    "status": "partial",
    "tests": [],
    "notes": "Existing tests listed here were inspected, not run for this documentation task. The area checker validates the contract files; it does not exercise runtime behavior."
  },
  "known_deviations": [
    {
      "text": "verify_channel checks only that index has the format marker; install applies full index structure checks. Its published_at field is only checked as a string.",
      "evidence": [
        "lumeri_runtime/official_channel.py:165-175",
        "lumeri_runtime/official_channel.py:260-269"
      ],
      "test": null
    },
    {
      "text": "The file consumer verifies basic signed payload shape before full index validation. A valid signature alone is not evidence the packages are loadable.",
      "evidence": [
        "lumeri_runtime/official_channel.py:165-175",
        "lumeri_runtime/official_channel.py:263-269"
      ],
      "test": null
    }
  ],
  "open_questions": [],
  "definitions": {
    "document": {
      "type": "object",
      "properties": {
        "payload": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        }
      },
      "required": [
        "payload",
        "signature",
        "key_id"
      ],
      "description": "Base64 payload and Ed25519 signature with a syntactically valid key_id. No signing material is part of this interface.",
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "format": {
          "const": "lumeri.official-luc-channel/v1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "published_at": {
          "type": "string"
        },
        "index": {
          "type": "object",
          "properties": {
            "format": {
              "const": "lumeri.official-luc-index/v1"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "format",
            "packages"
          ]
        }
      },
      "required": [
        "format",
        "sequence",
        "published_at",
        "index"
      ],
      "additionalProperties": false
    }
  }
}
