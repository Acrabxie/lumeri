    ]
  },
  "conformance": {
    "status": "exists",
    "tests": [
      "tests/test_luc_modules.py::test_a_file_that_does_not_read_trips_nothing",
      "tests/test_luc_modules.py::test_a_new_layered_version_starts_at_zero_and_reset_forgets",
      "tests/test_luc_modules.py::test_the_third_break_of_one_layered_version_trips_it",
      "tests/test_luc_modules.py::test_breaker_derives_tripped_from_breaks_and_locks_across_processes"
    ],
    "notes": "Verified by unit and cross-process tests in test_luc_modules.py."
  },
