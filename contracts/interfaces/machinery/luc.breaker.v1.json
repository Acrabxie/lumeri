      ]
    }
  ],
  "invariants": [
    {
      "id": "third-break-trips",
      "text": "Only the exact module and layered hash with at least three recorded breaks are held.",
      "test": "tests/test_luc_modules.py::test_the_third_break_of_one_layered_version_trips_it"
    },
    {
      "id": "new-hash-and-reset",
      "text": "A new hash starts at one; reset forgets only the selected module.",
      "test": "tests/test_luc_modules.py::test_a_new_layered_version_starts_at_zero_and_reset_forgets"
    },
    {
      "id": "unreadable-does-not-trip",
      "text": "Absent, unreadable, malformed or oversized input reports no trips.",
      "test": "tests/test_luc_modules.py::test_a_file_that_does_not_read_trips_nothing"
    },
    {
      "id": "derived-tripped-and-cross-process-lock",
      "text": "Readers derive tripped from breaks >= 3 and writers lock across processes.",
      "test": "tests/test_luc_modules.py::test_breaker_derives_tripped_from_breaks_and_locks_across_processes"
    }
  ],
  "failure": {
