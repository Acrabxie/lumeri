{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumeri.io/schemas/luc/interface-index-v1.schema.json",
  "title": "Lumeri module interface index v1",
  "description": "The modules of one area and the interfaces each provides. The rules are in docs/luc/interfaces.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "area", "modules"],
  "properties": {
    "format": {"const": "lumeri.interface-index/v1"},
    "area": {"enum": ["tools", "editor", "agent", "data", "process", "machinery"]},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "inventory", "status", "end_state", "interfaces"],
        "properties": {
          "module": {"type": "string", "pattern": "^lumeri\\.[a-z0-9][a-z0-9.-]{1,80}$"},
          "inventory": {"type": "string", "minLength": 1, "maxLength": 200},
          "status": {"enum": ["luc", "partly", "not-yet"]},
          "end_state": {"enum": ["replaceable", "official-only"]},
          "retire_candidate": {"type": "boolean"},
          "interfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^iface:[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+/v[1-9][0-9]*$"}
          },
          "notes": {"type": "string", "maxLength": 1000, "pattern": "^[\\x20-\\x7e]*$"}
        }
      }
    }
  }
}
