{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumeri.io/schemas/luc/interface-contract-v1.schema.json",
  "title": "Lumeri module interface contract v1",
  "description": "One interface of one or more Lumeri modules. The rules are in docs/luc/interfaces.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "id", "version", "area", "title", "summary", "carrier", "replaceability",
    "reach", "operations", "events", "bounds", "invariants", "failure", "conformance",
    "known_deviations", "open_questions"
  ],
  "properties": {
    "format": {"const": "lumeri.interface/v1"},
    "id": {"type": "string", "pattern": "^iface:[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+/v[1-9][0-9]*$"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "area": {"enum": ["tools", "editor", "agent", "data", "process", "machinery"]},
    "title": {"$ref": "#/$defs/line"},
    "summary": {"$ref": "#/$defs/text"},
    "carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["luc-protocol", "http", "event", "python", "subprocess", "browser", "file", "native"]},
        "protocol": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}(?:/[a-z0-9][a-z0-9._-]{0,31})?$"},
        "surface": {"$ref": "#/$defs/line"},
        "seam": {"$ref": "#/$defs/line"},
        "workspace_module": {
          "description": "lumeri.panel/v2 only: the workspace module whose role this interface is (Acrab, 2026-10-24). Any Panel a workspace places in that module keeps this interface; when it does not, or breaks, the Panel that holds the role in the Official workspace takes the module back.",
          "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "editor_role": {
          "description": "lumeri.panel/v2 only: a built-in editor region (preview, timeline, canvas-inspector, transcript) whose role this interface is. Any Panel a workspace places in that region keeps this interface; when it does not, or is disabled or breaks, the editor's own built-in view takes the region back.",
          "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "notes": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "luc-protocol"}}}, "then": {"required": ["protocol"]}},
        {"if": {"properties": {"kind": {"const": "python"}}}, "then": {"required": ["seam"]}}
      ]
    },
    "replaceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "why", "decided"],
      "properties": {
        "class": {"enum": ["open", "reviewed", "sandboxed", "lumeri-only"]},
        "why": {"$ref": "#/$defs/text"},
        "decided": {"$ref": "#/$defs/line"},
        "layer_may_patch": {
          "description": "lumeri-only only: JSON pointers into the module's Luc manifest that a creator's layer may still change. It may change nothing else.",
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(/[^/]+)+$"}
        }
      }
    },
    "reach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissions", "host_apis", "editable"],
      "properties": {
        "permissions": {"$ref": "#/$defs/names"},
        "host_apis": {"$ref": "#/$defs/names"},
        "editable": {
          "oneOf": [
            {"const": "none"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["target_types", "properties", "areas"],
              "properties": {
                "target_types": {"$ref": "#/$defs/names"},
                "properties": {"$ref": "#/$defs/names"},
                "areas": {"$ref": "#/$defs/names"}
              }
            }
          ]
        },
        "bridge_calls": {"$ref": "#/$defs/names"},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "bounds": {"type": "array", "items": {"$ref": "#/$defs/bound"}},
    "invariants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invariant"}},
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["break", "fallback", "evidence"],
      "properties": {
        "break": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "fallback": {"enum": ["original", "official-panel", "builtin-view", "refuse", "fail-closed"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tests"],
      "properties": {
        "status": {"enum": ["exists", "partial", "planned"]},
        "tests": {"type": "array", "items": {"$ref": "#/$defs/testRef"}},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "known_deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence", "test"],
        "properties": {
          "text": {"$ref": "#/$defs/text"},
          "evidence": {"$ref": "#/$defs/evidence"},
          "test": {"oneOf": [{"$ref": "#/$defs/testRef"}, {"type": "null"}]}
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "for"],
        "properties": {
          "text": {"$ref": "#/$defs/text"},
          "for": {"enum": ["acrab", "lumeri"]}
        }
      }
    },
    "definitions": {
      "description": "Named schemas this contract owns, for its own operations and for other contracts to point at with {\"$contract\": \"<file>#/definitions/<name>\"}.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/schema"}
    }
  },
  "$defs": {
    "line": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[\\x20-\\x7e]+$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[\\x20-\\x7e\\n]+$"},
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:/*-]{1,120}$"}},
    "evidence": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(~/)?[A-Za-z0-9_./@+-][A-Za-z0-9_./@+ -]*(:[1-9][0-9]*(-[1-9][0-9]*)?)?$"}
    },
    "testRef": {"type": "string", "pattern": "^tests/[A-Za-z0-9_./-]+\\.py(::[A-Za-z0-9_\\[\\]-]+)*$"},
    "schema": {
      "oneOf": [
        {
          "type": "object",
          "required": ["$contract"],
          "additionalProperties": false,
          "properties": {"$contract": {"type": "string", "pattern": "^(contracts|docs/luc/schemas|docs/luc/cloud-schemas)/[A-Za-z0-9_./-]+\\.json(#.*)?$"}}
        },
        {"type": "object", "not": {"required": ["$contract"]}},
        {"type": "boolean"}
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "effect", "input", "output", "errors", "deadline_ms", "idempotency", "status", "evidence"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:/ {}-]{0,119}$"},
        "capability": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"},
        "effect": {"enum": ["none", "read", "write", "paid", "process"]},
        "input": {"$ref": "#/$defs/schema"},
        "output": {"$ref": "#/$defs/schema"},
        "errors": {"$ref": "#/$defs/names"},
        "deadline_ms": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "idempotency": {"enum": ["none", "natural", "client_op_id", "idempotency_key", "execution_id"]},
        "status": {"enum": ["defined", "draft"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "payload", "evidence"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,119}$"},
        "payload": {"$ref": "#/$defs/schema"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit", "evidence"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,79}$"},
        "value": {"type": ["integer", "number", "string"]},
        "unit": {"$ref": "#/$defs/line"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "test"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
        "text": {"$ref": "#/$defs/text"},
        "test": {"oneOf": [{"$ref": "#/$defs/testRef"}, {"type": "null"}]}
      }
    }
  }
}
