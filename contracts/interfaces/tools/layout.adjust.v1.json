      "evidence": [
        "lumeri_runtime/luc_interactions.py:31-35"
      ]
    },
    {
      "name": "recent_draft_receipts",
      "value": 32,
      "unit": "receipts per active interaction",
      "evidence": [
        "lumeri_runtime/luc_interactions.py:34"
      ]
    },
    {
      "name": "retained_terminal_interactions",
      "value": 64,
      "unit": "records per Session",
      "evidence": [
        "lumeri_runtime/luc_interactions.py:35"
      ]
    }
  ],
  "invariants": [
    {
      "id": "confirmed-transform-only",
      "text": "Only a static unlocked text layer with no transformed/clipped parent and no transform keyframes can be changed; emphasis never becomes a Project edit.",
      "test": null
    }
  ],
  "failure": {
    "break": [
      "Context, task, account, Project revision or target binding is no longer current.",
      "Primitive validation, state persistence, preview or confirmed apply fails."
    ],
    "fallback": "refuse",
    "evidence": [
      "lumeri_runtime/luc_interactions.py:609-620",
      "lumeri_runtime/luc_interactions.py:828-850"
    ],
    "notes": "Cancellation resumes with {status: cancelled}; a failure invalidates preview and releases the wait with its error. There is no operation-level automatic layer-to-original retry at this interaction seam."
  },
  "conformance": {
    "status": "partial",
    "tests": [
      "tests/test_official_luc_interactions.py",
      "tests/test_runtime_luc_interactions.py"
    ],
    "notes": "Existing tests were inspected, not executed. Structural checking does not establish live availability, GUI acceptance or replacement conformance."
  },
  "known_deviations": [
    {
      "text": "The capability descriptor also permits a mounted handle, but Runtime 1.1 invoke waits for the human and returns the terminal result. Callers must distinguish a surface mount from a finished interaction.",
      "evidence": [
        "lumeri_runtime/luc.py:113-120",
        "lumeri_runtime/luc_interactions.py:610-620"
      ],
      "test": null
    }
  ],
