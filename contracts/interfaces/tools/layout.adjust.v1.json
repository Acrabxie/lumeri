{
  "format": "lumeri.interface/v1",
  "id": "iface:layout.adjust/v1",
  "version": "1.0.0",
  "area": "tools",
  "title": "Ask for a text-layer layout",
  "summary": "Let the creator adjust one existing static, center-anchored text layer. Position and uniform scale can be committed only with Native human confirmation; emphasis remains proposal data.",
  "carrier": {
    "kind": "luc-protocol",
    "protocol": "lumeri.interaction/v1",
    "surface": "layout-adjust",
    "notes": "Reached through luc_invoke after discovery and description. Schemas describe the result before the wrapper; Runtime context and authority are supplied separately by the Host."
  },
  "replaceability": {
    "class": "open",
    "why": "interaction/v1 is an open data protocol. The Host owns the surface, primitive validation, continuation and confirmation machinery. A layer cannot acquire authority beyond the manifest boundary.",
    "decided": "today's code: lumeri_runtime/luc_local.py:65-73"
  },
  "reach": {
    "permissions": [
      "ui.mount",
      "project.read",
      "project.write"
    ],
    "host_apis": [
      "project.read",
      "canvas.inspect",
      "canvas.preview",
      "interaction.mount",
      "interaction.update",
      "canvas.transform.apply"
    ],
    "editable": {
      "areas": [
        "canvas"
      ],
      "properties": [
        "transform.position",
        "transform.scale"
      ],
      "target_types": [
        "lumenframe_text_layer"
      ]
    },
    "notes": "The Host retains account/session binding and human confirmation. Optional Host APIs remain optional, not effective grants. The operation has no access to the editor native bridge."
  },
  "operations": [
    {
      "name": "collect",
      "capability": "layout.adjust",
      "effect": "write",
      "input": {
        "$contract": "contracts/interfaces/tools/layout.adjust.v1.json#/definitions/input"
      },
      "output": {
        "$contract": "contracts/interfaces/tools/layout.adjust.v1.json#/definitions/result"
      },
      "errors": [
        "E_LUC",
        "E_LUC_INVOKE_UNSUPPORTED",
        "E_LUC_CONTEXT",
        "E_LUC_BUSY",
        "E_LUC_STOPPED",
        "E_LUC_CONTINUATION_LOST",
        "E_LUC_REVISION",
        "E_LUC_IDENTITY_CHANGED",
        "E_LUC_STATE",
        "E_LUC_DELIVERY",
        "E_LUC_TARGET",
        "E_LUC_TARGET_LOCKED",
        "E_LUC_TARGET_KEYFRAMED",
        "E_LUC_TARGET_TRANSFORM_CONTEXT",
        "E_LUC_TARGET_NOT_FOUND",
        "E_LUC_CONFIRMATION_REQUIRED",
        "E_LUC_APPLY_UNSUPPORTED",
        "E_LUC_APPLY_FAILED",
        "E_LUC_APPLY_READBACK"
      ],
      "deadline_ms": null,
      "idempotency": "none",
      "status": "defined",
      "evidence": [
        "lumeri_runtime/luc.py:84-111",
        "lumeri_runtime/luc.py:186-234",
        "lumeri_runtime/luc_interactions.py:569-620",
        "lumeri_runtime/luc_interactions.py:695-758",
        "lumeri_runtime/luc_interactions.py:524-549",
        "lumeri_runtime/luc_interactions.py:771-810"
      ],
      "notes": "There is deliberately no human-wait deadline: the same task blocks on its event until completion, cancellation, stop or failure. A new invocation is a new interaction, not a replay. Native confirmation binds the exact normalized proposal and revision. Apply uses interaction_id.apply as its key; submission retries reuse their submission_id receipts. Draft preview does not commit."
    }
  ],
  "events": [
    {
      "name": "luc_interaction_state",
      "payload": {
        "type": "object",
        "properties": {
          "interaction": {
            "$contract": "contracts/interfaces/tools/layout.adjust.v1.json#/definitions/interaction_view"
          }
        },
        "required": [
          "interaction"
        ],
        "additionalProperties": false
      },
      "evidence": [
        "lumeri_runtime/luc_interactions.py:462-493"
      ],
      "notes": "The Runtime stores and publishes the same state projection; binding and continuation remain Host-owned."
    },
    {
      "name": "luc_interaction_preview",
      "payload": {
        "$contract": "docs/luc/schemas/preview-event-v1.schema.json"
      },
      "evidence": [
        "lumeri_runtime/luc_runtime_adapter.py:66-80"
      ],
      "notes": "An ephemeral projection, never a durable Project write or human confirmation."
    }
  ],
  "bounds": [
    {
      "name": "agent_result_chars",
      "value": 6000,
      "unit": "characters before the model result is clipped; the cut notice is appended",
      "evidence": [
        "lumeri_runtime/agent_turn.py:38-42",
        "lumeri_runtime/agent_turn.py:423-430"
      ]
    },
    {
      "name": "state_bytes",
