        "properties": {
          "op": {
            "enum": [
              "upsert_annotation",
              "remove_annotation",
              "replace_source"
            ],
            "description": "upsert_annotation writes or rewrites one note; remove_annotation takes one away; replace_source swaps every note one source left about the asset for a new set."
          },
          "asset_id": {
            "type": "string",
            "description": "The asset the notes are about."
          },
          "annotation_id": {
            "type": "string",
            "description": "remove_annotation: the note."
          },
          "data": {
            "type": "object",
            "description": "upsert_annotation: {annotation}. replace_source: {source, annotations}.",
            "properties": {
              "annotation": {
                "type": "object",
                "properties": {
                  "annotation_id": {
                    "type": "string"
                  },
                  "scope": {
                    "enum": [
                      "asset",
                      "frame",
                      "time_range"
                    ]
                  },
                  "start_sec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_sec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "frame": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "label": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "category": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "source": {
                    "enum": [
                      "gemini",
                      "gemini_vision",
                      "heuristic",
                      "import",
                      "roughcut",
                      "system",
                      "user"
                    ]
                  },
                  "language": {
                    "type": "string"
                  }
                },
                "required": [
                  "annotation_id"
                ]
              },
              "source": {
                "enum": [
                  "gemini",
                  "gemini_vision",
                  "heuristic",
                  "import",
                  "roughcut",
                  "system",
                  "user"
                ]
              },
              "annotations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "annotation_id": {
                      "type": "string"
                    },
                    "scope": {
                      "enum": [
                        "asset",
                        "frame",
                        "time_range"
                      ]
                    },
                    "start_sec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end_sec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "frame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "label": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "category": {
                      "type": "string"
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "source": {
                      "enum": [
                        "gemini",
                        "gemini_vision",
                        "heuristic",
                        "import",
                        "roughcut",
                        "system",
                        "user"
                      ]
                    },
                    "language": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "annotation_id"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "op",
          "asset_id"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "annotations": {
            "$contract": "contracts/interfaces/tools/media.notes.v1.json#/definitions/annotations"
          },
          "project_revision": {
            "type": "integer"
          }
        },
        "required": [
          "annotations",
          "project_revision"
        ],
        "additionalProperties": false
      },
      "errors": [
        "arguments_invalid",
        "annotation_patch_refused",
        "approval_required",
        "document_edit_failed",
        "E_LUC_EDIT_SCOPE",
        "E_LUC_API_UNDECLARED",
        "E_LUC_API_PERMISSION",
        "E_LUC_API_UNAVAILABLE",
        "E_LUC_PROGRAM_BROKE"
      ],
      "deadline_ms": null,
      "idempotency": "idempotency_key",
      "status": "defined",
      "evidence": [
        "official_luc/annotations/tools.py:188-245",
        "official_luc/annotations/tools.py:270-344",
        "official_luc/annotations/tools.py:370-410",
        "lumeri_runtime/luc_packaged_tools.py:405-452",
        "lumeri_runtime/luc_host_api.py:590-602",
        "official_luc/annotations/tools.py:170-185"
      ],
      "notes": "No end-to-end call deadline is enforced. The Runtime derives the write key from turn_id, tool_call_id and document capability. Retrying the same call uses that key; a new call can write again. remove_annotation refuses an absent id; replace_source preserves all other sources. Shape validation is stricter than the shipped input schema."
    }
