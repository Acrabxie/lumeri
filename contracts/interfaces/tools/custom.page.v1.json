      "output": {
        "$contract": "contracts/interfaces/tools/custom.page.v1.json#/definitions/result"
      },
      "errors": [
        "E_LUC_CUSTOM_INPUT",
        "E_LUC_CUSTOM_RUNTIME",
        "E_LUC_CUSTOM_SCOPE",
        "E_LUC_CUSTOM_CONFLICT",
        "E_LUC_CUSTOM_CAPACITY",
        "E_LUC_CUSTOM_NOT_FOUND",
        "E_LUC_CUSTOM_BUSY",
        "E_LUC_CUSTOM_REVISION",
        "E_LUC_CUSTOM_STATE",
        "E_LUC_CUSTOM_OUTPUT",
