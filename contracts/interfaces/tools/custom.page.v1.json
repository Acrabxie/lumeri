                "properties": {
                  "control_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 192
                  },
                  "value": {}
                },
                "required": [
                  "control_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operation",
              "page_id",
              "expected_revision",
              "event"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "const": "unmount"
              },
              "page_id": {
                "type": "string",
