  "invariants": [
    {
      "id": "plain-controls-only",
      "text": "The page declaration permits only bounded text, number, toggle, select and button controls; HTML and scripts are refused.",
      "test": "tests/test_official_luc_custom.py::CustomTests::test_page_manifest_html_script_and_backend_escape_rejected"
    },
    {
      "id": "explicit-unmount",
      "text": "The renderer explicitly acknowledges mount/update/unmount. Successful unmount is reflected in the lifecycle result.",
      "test": "tests/test_official_luc_custom.py::CustomTests::test_page_create_load_mount_interact_unmount"
    }
  ],
  "failure": {
    "break": [
      "A replacement program exits, exceeds its deadline or returns an invalid result/refusal.",
      "The trusted binding is absent, changed or refuses the invocation.",
      "An input, result or Host context fails validation."
    ],
    "fallback": "original",
    "evidence": [
      "lumeri_runtime/luc_custom.py:306-315",
      "lumeri_runtime/luc_custom.py:567-582",
      "lumeri_runtime/luc_tool_program.py:294-348"
    ],
    "notes": "When a layer's program breaks, the adapter records the break in LucBreaker and falls back to the Official custom-page implementation for the rest of the start."
  },
  "conformance": {
    "status": "exists",
    "tests": [
      "tests/test_official_luc_custom.py",
      "tests/test_luc_tool_program.py"
    ],
    "notes": "Verified across Official adapter tests and sandboxed program on/off/break replacement tests."
  },
  "known_deviations": [
    {
      "text": "Page records and create replay receipts are in-memory only. A restart invalidates page_id and cannot restore the page; after a renderer/backend LucError the operation returns status=error rather than automatically retrying the original.",
      "evidence": [
        "lumeri_runtime/luc_custom.py:513-517",
        "lumeri_runtime/luc_custom.py:605-607",
        "lumeri_runtime/luc_custom.py:668-672"
      ],
      "test": "tests/test_official_luc_custom.py::CustomTests::test_revoked_scope_and_restart_refuse_retained_page_state"
    },
    {
      "text": "Host ports may be absent even after the capability loads. A page cannot mount until a trusted renderer/dispatcher is explicitly integrated.",
      "evidence": [
        "lumeri_runtime/luc_custom.py:322-329",
        "lumeri_runtime/luc_custom.py:701-705"
      ],
      "test": "tests/test_official_luc_custom.py::CustomTests::test_unbound_actual_runtime_is_explicitly_blocked"
    }
  ],
