{
  "format": "lumeri.interface/v1",
  "id": "iface:custom.page/v1",
  "version": "1.0.1",
  "area": "tools",
  "title": "Run a declarative custom page",
  "summary": "Create, load, mount, interact with and unmount a bounded native-control page. Its actions call only the declared project.snapshot-card backend; there is no HTML, script or Project write surface.",
  "carrier": {
    "kind": "luc-protocol",
    "protocol": "lumeri.custom-page/v1",
    "surface": "luc_invoke",
    "notes": "Reached through luc_invoke after discovery and description. Schemas describe the result before the wrapper; Runtime context and authority are supplied separately by the Host."
  },
  "replaceability": {
    "class": "sandboxed",
    "why": "Page lifecycle records and renderer/backend ports are trusted Runtime adapters. A creator's layer on the Official package may add a sandboxed program (luc_tool_program) that answers for the capability while keeping its pinned backend_ids, input/output schemas and authority.",
    "decided": "Acrab, 2026-10-24; sandboxed program replacement wired via luc_tool_program (lumeri_runtime/luc_custom.py:507-582, lumeri_runtime/luc_interface_gate.py:35-44)"
  },
  "reach": {
    "permissions": [
      "project.read",
      "ui.mount"
    ],
    "host_apis": [
      "project.read",
      "interaction.mount",
      "interaction.update"
    ],
    "editable": "none"
  },
  "operations": [
    {
      "name": "page_lifecycle",
      "capability": "custom.page",
      "effect": "process",
      "input": {
