          "terminated"
        ],
        "additionalProperties": false
      },
      "errors": [],
      "deadline_ms": 2000,
      "idempotency": "natural",
      "status": "defined",
      "evidence": [
        "lumeri_runtime/luc_sandbox.py:341-360",
        "lumeri_runtime/luc_agent_loop.py:663-670"
      ],
      "notes": "Carried as end of input: when the creator stops the turn, or the turn ends, the Runtime closes the program's stdin, waits the grace interval and then kills its process group. terminated is true when it ended by itself. The creator's stop answers every unanswered call with a stopped result, as the original does."
    },
    {
      "name": "process_exit",
      "effect": "process",
      "input": {
        "type": "object",
        "properties": {
          "v": {
            "const": 1
          },
          "turn_id": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "v",
          "turn_id",
          "exit_code"
        ],
        "additionalProperties": false
      },
      "output": {
        "$contract": "contracts/interfaces/agent/agent.loop.v1.json#/definitions/checkpoint"
      },
      "errors": [],
      "deadline_ms": null,
      "idempotency": "natural",
      "status": "defined",
      "evidence": [
        "lumeri_runtime/luc_agent_loop.py:769-774",
        "lumeri_runtime/agent_turn.py:854-864",
        "lumeri_runtime/worker.py:8440-8500"
      ],
      "notes": "Every break (a program that does not start, answers late, out of shape or too large, exceeds its memory or CPU bound, asks for an action it may not take, or ends) stops the program; the original carries the turn on from the last performed action, finishing the reply in hand from its first unanswered call, so no model step is asked twice and no call runs twice. The module falls back for the rest of this start, the breaker counts one break, and the Session hears luc.module_fell_back once."
    }
  ],
