{
  "format": "lumeri.interface/v1",
  "id": "iface:agent.loop/v1",
  "version": "1.2.0",
  "area": "agent",
  "title": "Decide the next action of an agent turn",
  "summary": "The decisions of an agent turn: ask the model with a window of the conversation, run or skip the next tool call it asked for, or end the turn. The original is AgentTurn's own code. A reviewed Luc may bring a program that decides instead, over one JSON line in and one out per action, fenced in the operating system's sandbox; the Runtime checks and performs every action, and keeps the model, the tools, the conversation, the budget, the receipts and the events. A program that breaks is stopped and the original carries the turn on from the last performed action.",
  "carrier": {
    "kind": "subprocess",
    "surface": "sandbox-json-lines",
    "notes": "Original: lumeri_runtime.agent_turn:AgentTurn.run. Replacement: a lumeri.agent.loop/v1 capability naming an executable file of its Luc, run by luc_sandbox under sandbox-exec with an empty environment; the Runtime writes one request line and reads one answer line per action (luc_agent_loop.drive)."
  },
  "replaceability": {
    "class": "sandboxed",
    "why": "A replacement is code. It runs only as a child process in the code sandbox: it reads its own executable, the system libraries and the page size, writes nothing, opens no file or socket, and holds no credential. It runs only from a Luc that holds agent.loop, which Lumeri's review of its exact bytes grants, and only on a machine with a sandbox (macOS today).",
    "decided": "Self-Luc spec v0.3 (2026-10-18); charter rule 6; Acrab 2026-10-25: agent core as a Luc; Acrab 2026-10-26: the code sandbox and its numbers approved"
  },
  "reach": {
    "permissions": [
      "agent.loop"
    ],
    "host_apis": [],
    "editable": "none",
    "notes": "The child cannot use network, filesystem, account or provider credentials (luc_sandbox.sandbox_profile). It suggests actions only; the Runtime validates and performs every model step and tool call under the turn's delegation. Hints (tools, budget) are information, not authority."
  },
