  "invariants": [
    {
      "id": "doom-stop",
      "text": "The original stops after three identical tool name and argument strings in the recent-call tail, checked after a model step.",
      "test": "tests/test_runtime_agent_turn.py::test_the_same_call_three_times_running_ends_the_turn"
    },
    {
      "id": "doom-stop-for-any-program",
      "text": "With a program deciding, the Runtime still ends the turn after the third identical call, without asking it.",
      "test": "tests/test_luc_agent_loop.py::test_a_doom_loop_is_stopped_by_the_runtime_whatever_the_program_decides"
    },
    {
      "id": "unconfirmed-step",
      "text": "A model step that was sent and whose answer is never confirmed ends the original's turn with model_result_unconfirmed; the step keeps its reservation until its provider settles it and is never sent again.",
      "test": "tests/test_runtime_chatgpt_bridge.py::test_an_answer_lost_on_its_way_back_ends_the_turn_by_name_and_is_never_asked_again"
    },
    {
      "id": "unconfirmed-step-for-any-program",
      "text": "With a program deciding, such a step ends the turn the same way, without asking the program and without counting a break.",
      "test": "tests/test_luc_agent_loop.py::test_a_step_whose_answer_never_came_back_ends_the_turn_by_name_and_is_no_break"
    },
    {
      "id": "checkpoint-before-handoff",
      "text": "Before the Runtime performs an action it has persisted the action, state and idempotency key; after, the result.",
      "test": "tests/test_luc_agent_loop.py::test_each_action_is_written_down_before_the_runtime_performs_it"
    },
    {
      "id": "checkpoint-recovered-after-crash",
      "text": "An in-flight checkpoint is read back on crash recovery without re-sending settled or unconfirmed model steps or re-running governed writing tool calls.",
      "test": "tests/test_luc_agent_loop.py::test_checkpoint_is_read_back_after_crash_without_repeating_settled_model_steps_or_writes"
    },
    {
      "id": "fallback-asks-nothing-twice",
      "text": "After a break the original carries the turn on: the model steps sent are the ones the original alone sends, each once, and each call runs once.",
      "test": "tests/test_luc_agent_loop.py::test_a_program_that_breaks_hands_the_turn_to_lumeris_own_loop_asking_nothing_twice"
    },
    {
      "id": "same-steps-as-the-original",
      "text": "A program that decides as the original does produces the same model requests, events and conversation.",
      "test": "tests/test_luc_agent_loop.py::test_a_reviewed_loop_runs_the_turn_exactly_as_lumeris_own_loop_would"
    },
    {
      "id": "answers-as-the-contract",
      "text": "The Runtime accepts exactly the answers this contract's response schema allows.",
      "test": "tests/test_luc_agent_loop.py::test_the_runtime_accepts_exactly_the_answers_the_contract_allows"
    },
    {
      "id": "sandboxed",
      "text": "The program reads no file but its own and the system libraries, and no system setting but the page size; it writes nothing, reaches no network and has an empty environment.",
      "test": "tests/test_luc_agent_loop.py::test_the_program_reads_no_file_writes_nothing_reaches_no_network_and_has_no_environment"
    }
  ],
