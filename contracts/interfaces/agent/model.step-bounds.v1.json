  ],
  "invariants": [
    {
      "id": "standin-no-wider",
      "text": "A stand-in with a wider output cap, cost ceiling or different product is refused as agent_stand_in_invalid.",
      "test": "tests/test_luc_agent.py::test_the_step_goes_out_under_the_stand_in_and_its_record_says_so"
    },
    {
      "id": "balance-ceiling",
      "text": "For credit steps, reservation equals the lesser of the profile ceiling and Session balance.",
      "test": "tests/test_runtime_agent_step.py::test_the_step_cost_is_the_smaller_of_profile_and_session_balance"
    },
    {
      "id": "no-injected-system",
      "text": "Conversation messages cannot inject a second system prompt.",
      "test": "tests/test_runtime_agent_step.py::test_the_conversation_cannot_carry_a_second_system_prompt"
    }
  ],
  "failure": {
    "break": [
      "the operation raises unexpectedly or returns an answer outside its declared schema"
    ],
    "fallback": "fail-closed",
    "evidence": [
      "lumeri_runtime/model_ingress.py:574-725"
    ],
    "notes": "Refuse before execute_capability reserves anything. agent_stand_in_invalid remains the low-level guard; normal Worker selection catches a broken stand-in earlier and uses the original. Identity codes belong to accounts."
  },
  "conformance": {
    "status": "partial",
    "tests": [
      "tests/test_luc_agent.py::test_the_step_goes_out_under_the_stand_in_and_its_record_says_so",
      "tests/test_runtime_agent_step.py::test_the_step_cost_is_the_smaller_of_profile_and_session_balance",
      "tests/test_runtime_agent_step.py::test_the_conversation_cannot_carry_a_second_system_prompt"
    ],
    "notes": "Existing tests are evidence for the named invariants, not a replacement conformance runner. Only the area contract checker is run in this task."
  },
