  },
  "replaceability": {
    "class": "lumeri-only",
    "why": "lumeri.renderer/v1 and permission renderer.execute are reserved for the Official lumeri.lumenframe2 package; third-party Lucs are refused at load time and scene HTML runs without Host authority.",
    "decided": "Acrab 2026-10-31 / docs/lumenframe2.md:303-308; lumeri_runtime/luc_local.py:100-105; lumeri_runtime/lumenframe2_adapter.py:218-290"
  },
