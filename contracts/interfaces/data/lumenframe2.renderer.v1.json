      "properties": [
        "scene.source",
        "scene.parameters",
        "scene.history"
      ],
      "areas": [
        "project"
      ]
    },
    "notes": "Editable metadata is restricted to metadata.lucs['lumeri.lumenframe2'] through the governed Project gate; scene JS receives no Host APIs or filesystem writes."
