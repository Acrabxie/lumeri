{
  "format": "lumeri.interface/v1",
  "id": "iface:lumenframe2.point2d/v1",
  "version": "1.0.0",
  "area": "data",
  "title": "LumenFrame 2 2D spatial point collector",
  "summary": "Collects a single normalized or pixel 2D point on the Host interaction plane for an LF2 scene parameter.",
  "carrier": {
    "kind": "luc-protocol",
    "protocol": "lumeri.interaction/v1",
    "surface": "point2d",
    "notes": "Shipped inside lumeri.lumenframe2 0.3.0 and carried through Host InteractionAdapter (LucInteractions)."
