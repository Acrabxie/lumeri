              "type": {
                "const": "point2d"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "space": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^\\S(?:[\\s\\S]{0,94}\\S)?$"
              },
              "origin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^\\S(?:[\\s\\S]{0,94}\\S)?$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
