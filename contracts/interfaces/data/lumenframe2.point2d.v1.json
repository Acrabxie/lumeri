              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^\\S(?:[\\s\\S]{0,94}\\S)?$"
              }
            },
            "required": [
              "type",
              "x",
              "y",
              "space",
              "origin",
              "anchor",
              "mode",
              "reference"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "space": {
                      "pattern": "\\.normalized$"
                    }
                  },
                  "required": [
                    "space"
                  ]
                },
                "then": {
                  "properties": {
                    "x": {
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            ]
          },
          "presentation": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "label",
          "initial"
        ],
        "additionalProperties": false
