{
  "format": "lumeri.interface/v1",
  "id": "iface:lumenframe2.parameters/v1",
  "version": "1.0.0",
  "area": "data",
  "title": "LumenFrame 2 exposed parameter bundle collector",
  "summary": "Collects finite scalar, boolean, string, and point2d parameter updates on the shared LumenFrame interaction surface.",
  "carrier": {
    "kind": "luc-protocol",
    "protocol": "lumeri.interaction/v1",
    "surface": "parameters",
    "notes": "Shipped inside lumeri.lumenframe2 0.3.0 and carried through Host InteractionAdapter (LucInteractions)."
  },
  "replaceability": {
    "class": "open",
    "why": "Uses the open lumeri.interaction/v1 protocol with host-enforced primitive and parameter schemas.",
    "decided": "lumeri_runtime/luc.py:70-115; lumeri_runtime/interaction_parameters.py:17-35"
  },
  "reach": {
    "permissions": [
      "ui.mount"
    ],
    "host_apis": [
      "interaction.mount",
      "interaction.update"
    ],
    "editable": "none",
    "notes": "Collects creator values only; confirmation writes stay on the caller's governed gate."
  },
  "operations": [
    {
      "name": "collect",
      "capability": "lumenframe2.parameters.collect",
      "effect": "none",
      "input": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "initial": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "maxLength": 32768
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "presentation": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "bindings": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                  },
                  "scale": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                  },
                  "rotation": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "label",
          "initial"
        ],
        "additionalProperties": false
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "draft"
              },
              "value": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                },
                "minProperties": 1,
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "maxLength": 32768
                    },
                    {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "status",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "completed"
              },
              "value": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                },
                "minProperties": 1,
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "maxLength": 32768
                    },
                    {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "status",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "cancelled"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        ]
      },
      "errors": [
        "E_LUC_CANCELLED",
        "E_LUC_STATE",
        "E_LUC_STALE"
      ],
      "deadline_ms": null,
      "idempotency": "client_op_id",
      "status": "defined",
      "evidence": [
        "official_luc/lumenframe2/manifest.json:644-853",
        "lumeri_runtime/luc.py:93-101",
        "lumeri_runtime/interaction_parameters.py:17-65"
      ],
      "notes": "Waits on the Host human interaction surface and returns draft/completed/cancelled values validated against host-owned schemas."
    }
  ],
  "events": [],
  "bounds": [
    {
      "name": "label_chars",
      "value": 160,
      "unit": "characters for interaction label",
      "evidence": [
        "official_luc/lumenframe2/manifest.json:260-320"
      ]
    }
  ],
  "invariants": [
    {
      "id": "collect-only-no-project-write",
      "text": "Interaction collection edits no Project state by itself; only the calling renderer commits confirmed values.",
      "test": "tests/test_lumenframe2_luc.py::test_shared_point2d_creator_completion_updates_only_own_parameters"
    }
  ],
  "failure": {
    "break": [
      "Creator cancels or Project revision/task/package changes while waiting."
    ],
    "fallback": "refuse",
    "evidence": [
      "lumeri_runtime/luc_interactions.py:609-620",
      "lumeri_runtime/luc.py:92-114"
    ],
    "notes": "Cancellation returns status cancelled; stale state or unload fences the wait."
  },
  "conformance": {
    "status": "exists",
    "tests": [
      "tests/test_lumenframe2_luc.py"
    ],
    "notes": "Verified through governed position and parameter collection flows."
  },
  "known_deviations": [],
  "open_questions": []
}
