{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumeri.io/schemas/luc/local-registry-inventory-v1.schema.json",
  "title": "Local Luc Registry logical inventory",
  "type": "object",
  "required": ["record_format", "installed", "profiles"],
  "properties": {
    "record_format": {"const": "lumeri.luc.local-registry/v1"},
    "installed": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/installed"}
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "required": ["id", "version"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}}
    },
    "base": {
      "type": "object", "required": ["id", "version", "source_hash"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "installed": {
      "type": "object",
      "required": ["kind", "identity", "source_hash", "artifact_hash", "origin", "enabled", "pinned_source_hash", "channel", "parent_luc", "installed_at_utc"],
      "properties": {
        "kind": {"enum": ["luc", "extension"]},
        "identity": {"$ref": "#/$defs/identity"},
        "source_hash": {"$ref": "#/$defs/hash"},
        "artifact_hash": {"$ref": "#/$defs/hash"},
        "origin": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "pinned_source_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "channel": {"type": "string", "minLength": 1},
        "parent_luc": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "installed_at_utc": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "extension": {
      "type": "object", "required": ["id", "version", "source_hash", "parent_luc", "layer_order", "enabled"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "source_hash": {"$ref": "#/$defs/hash"},
        "parent_luc": {"type": "string"},
        "layer_order": {"type": "integer", "minimum": 0},
        "enabled": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object", "required": ["resolved_hash", "resolved_source_hash", "base", "extensions", "resolver_version", "runtime_version", "effective_authority"],
      "properties": {
        "resolved_hash": {"$ref": "#/$defs/hash"},
        "resolved_source_hash": {"$ref": "#/$defs/hash"},
        "base": {"type": "object"},
        "extensions": {"type": "array"},
        "resolver_version": {"type": "string"},
        "runtime_version": {"type": "string"},
        "effective_authority": {"type": "object"}
      }
    },
    "activation_state": {
      "type": "object",
      "required": ["profile", "history", "cursor", "active", "previous", "last_known_good", "rollback_pin", "last_validation", "safe_mode"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "history": {"type": "array", "items": {"$ref": "#/$defs/hash"}},
        "cursor": {"type": "integer", "minimum": -1},
        "active": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "previous": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "last_known_good": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "rollback_pin": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "last_validation": {"type": "object"},
        "safe_mode": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "anyOf": [
        {"required": [
          "base", "extensions", "safe_mode", "resolved_hash", "resolver_version",
          "runtime_version", "last_validation", "effective_authority", "authority_diff",
          "requires_reauthorization"
        ]},
        {"required": ["activation_state"]}
      ],
      "properties": {
        "base": {"$ref": "#/$defs/base"},
        "extensions": {"type": "array", "items": {"$ref": "#/$defs/extension"}},
        "safe_mode": {"type": "boolean"},
        "resolved_hash": {"$ref": "#/$defs/hash"},
        "resolver_version": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "last_validation": {"type": "object"},
        "effective_authority": {"type": "object"},
        "authority_diff": {"type": "object"},
        "requires_reauthorization": {"type": "boolean"},
        "active_resolution": {"oneOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
        "previous_resolution": {"oneOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
        "last_known_good_resolution": {"oneOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
        "rollback_pin": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "activation_state": {"$ref": "#/$defs/activation_state"}
      },
      "additionalProperties": true
    }
  }
}
